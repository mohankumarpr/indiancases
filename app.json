        "keywords": "legal research, case law, Supreme Court, High Court, judgments, legal database, India, law cases, court decisions",
        "author": "IndianCases Research Team",
        "robots": "index, follow",
        "googlebot": "index, follow",
        "bingbot": "index, follow"
      }
    },
    "platforms": [
      "ios",
      "android",
      "web"
